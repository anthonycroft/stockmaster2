# Copy to .env for local development (python dev_server.py). Never commit .env.

# Local SQLite file (default if not set):
DATABASE_URL=file:stockmaster.db
# ...or the Turso database (same values as in Vercel's environment variables):
# DATABASE_URL=libsql://stockmaster-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<token from the Turso dashboard>

# The access key the site asks for before showing portfolios.
STOCKMASTER_API_KEY=dev

# Optional fallback price source
# POLYGON_API_KEY=
